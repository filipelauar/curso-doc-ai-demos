# ─────────────────────────────────────────────────────────────
# Copie para .env e preencha. O .env fica na RAIZ do repo e e
# lido por todas as demos via load_dotenv(find_dotenv()).
# ─────────────────────────────────────────────────────────────

# Aula 2 — Azure AI Document Intelligence (OCR tradicional)
# Portal Azure > AI Document Intelligence > Keys and Endpoint
AZURE_DI_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/
AZURE_DI_KEY=
# A demo usa sempre prebuilt-read ($1,50/1K pag.), o OCR tradicional puro.

# Aula 2 — Datalab / Chandra (OCR de LLM)
# https://www.datalab.to  (US$ 5 de credito gratis no cadastro)
DATALAB_API_KEY=
DATALAB_MODE=balanced
# Trava de custo: quantas paginas enviar por documento na demo
DATALAB_MAX_PAGES=5

# Aulas 4, 5 (extração para JSON) e 6 — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Aula 6 — embeddings (roda local, sem chave)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
